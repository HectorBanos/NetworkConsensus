"10PrimRAG2",
"10PrimIRBP",
"10PrimBRCA1",
"10PrimAPOB",
"10PrimVWF",
"10PrimGHR",
"10PrimMC1R",
"10PrimTYR",
"10PrimMITF"
)
atrees <- numeric(length(genes))
pitrees <- matrix(
0,
nrow = length(genes),
ncol = 4
)
ratetrees <- matrix(
0,
nrow = length(genes),
ncol = 6
)
for (i in seq_along(genes)) {
file <- paste0(genes[i], "v2.fa")
atrees[i]      <- getalpha(file)
pitrees[i, ]   <- getpi(file)
ratetrees[i, ] <- getrates(file)
}
exchange_df <- data.frame(
genes = factor(
rep(seq_len(nrow(ratetrees)), times = ncol(ratetrees)),
labels = gene_labels
),
parameter = factor(
rep(seq_len(ncol(ratetrees)), each = nrow(ratetrees))
),
value = as.vector(ratetrees)
)
gene_labels <- gsub("10Prim", "", genes)
gene_shapes <- c(
16, 17, 15, 18, 8,
3, 4, 7, 9, 10
)
common_theme <- theme_minimal() +
theme(
plot.title = element_text(
hjust = 0.5,
face = "bold"
)
)
exchange_df <- data.frame(
genes = factor(
rep(seq_len(nrow(ratetrees)), times = ncol(ratetrees)),
labels = gene_labels
),
parameter = factor(
rep(seq_len(ncol(ratetrees)), each = nrow(ratetrees))
),
value = as.vector(ratetrees)
)
ggplot(exchange_df, aes(x = parameter, y = value)) +
geom_boxplot(
outlier.shape = NA,
fill = "grey85",
color = "black"
) +
geom_point(
aes(color = genes, shape = genes),
size = 2,
alpha = 0.8,
position = position_jitter(width = 0.08)
) +
scale_colour_manual(
values = okabe_ito,
name = "Gene"
) +
scale_shape_manual(
values = gene_shapes,
name = "Gene"
) +
labs(
title = "Exchangeability across primate genes",
x = "",
y = "Exchangeability rate"
) +
common_theme
median_exch <- aggregate(value ~ parameter, exchange_df, median)
mean_exch   <- aggregate(value ~ parameter, exchange_df, mean)
basefreq_df <- data.frame(
genes = factor(
rep(seq_len(nrow(pitrees)), times = ncol(pitrees)),
labels = gene_labels
),
nucleotide = factor(
rep(seq_len(ncol(pitrees)), each = nrow(pitrees))
),
value = as.vector(pitrees)
)
nucleotide_labels <- c(
expression(pi[A]),
expression(pi[C]),
expression(pi[G]),
expression(pi[T])
)
ggplot(basefreq_df, aes(x = nucleotide, y = value)) +
geom_boxplot(
outlier.shape = NA,
fill = "grey85",
color = "black"
) +
geom_point(
aes(color = genes, shape = genes),
size = 1.8,
alpha = 0.7
) +
scale_colour_manual(
values = okabe_ito,
name = "Gene"
) +
scale_shape_manual(
values = gene_shapes,
name = "Gene"
) +
scale_x_discrete(labels = nucleotide_labels) +
labs(
title = "Base frequencies across primate genes",
x = "Nucleotide",
y = "Frequency"
) +
common_theme
median_basedist <- with(
aggregate(value ~ nucleotide, basefreq_df, median),
value / sum(value)
)
mean_basedist <- with(
aggregate(value ~ nucleotide, basefreq_df, mean),
value / sum(value)
)
alpha_df <- data.frame(
genes = factor(gene_labels),
group = factor(rep("All genes", length(atrees))),
value = atrees
)
ggplot(alpha_df, aes(x = group, y = value)) +
geom_boxplot(
outlier.shape = NA,
fill = "grey85",
color = "black"
) +
geom_point(
aes(color = genes, shape = genes),
size = 2,
alpha = 0.8,
position = position_jitter(width = 0.08)
) +
scale_colour_manual(
values = okabe_ito,
name = "Gene"
) +
scale_shape_manual(
values = gene_shapes,
name = "Gene"
) +
labs(
title = "Gamma shape parameter across primate genes",
x = "",
y = expression(alpha)
) +
common_theme
median_rates <- aggregate(value ~ group, alpha_df, median)
mean_rates   <- aggregate(value ~ group, alpha_df, mean)
median_rates
median_basedist
normalized_median_basedist <- with(
aggregate(value ~ nucleotide, basefreq_df, median),
value / sum(value)
)
normalized_median_basedist
normalized_mean_basedist
normalized_mean_basedist <- with(
aggregate(value ~ nucleotide, basefreq_df, mean),
value / sum(value)
)
normalized_mean_basedist
