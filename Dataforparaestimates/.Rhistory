leop = read.tree('leopardus.nwk')
maxratioleop=c()
dtreesleop=c()
i=1
is.rooted(leop[[i]])
rooted_tree <- root(leop[[i]],outgroup = "Puma_concolor" )
ingroup_tree <- drop.tip(rooted_tree, tip = "Puma_concolor")
is.rooted(ingroup_tree)
distances_all_castor <- get_all_distances_to_root(ingroup_tree)[1:length(ingroup_tree$tip.label)]
maxratioleop[i]=max(distances_all_castor)/min(distances_all_castor)
dtreesleop[i] = max(cophenetic(ingroup_tree))
