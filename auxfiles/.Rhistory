leibniz_pi <- function(n_terms) {
k <- 0:(n_terms - 1)
pi_approx <- 4 * sum((-1)^k / (2*k + 1))
return(pi_approx)
}
leibniz_pi(1000000)  # [1] 3.141591
leibniz_pi(10)  # [1] 3.141591
leibniz_pi(1000000)  # [1] 3.141591
leibniz_pi(1000000000000)  # [1] 3.141591
leibniz_pi(100000000)  # [1] 3.141591
chudnovsky_pi <- function(n_terms) {
k <- 0:(n_terms - 1)
numerator   <- (-1)^k * factorial(6*k) * (13591409 + 545140134*k)
denominator <- factorial(3*k) * factorial(k)^3 * 640320^(3*k + 3/2)
pi_approx <- 1 / (12 * sum(numerator / denominator))
return(pi_approx)
}
chudnovsky_pi(10)
chudnovsky_pi(1000)
chudnovsky_pi(12)
leibniz_pi(100000000)  # [1] 3.141591
chudnovsky_pi(20)
options(digits=15)
