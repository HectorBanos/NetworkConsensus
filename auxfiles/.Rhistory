n <- length(pi_digits)
# --- Map each digit to angle and radius ---
# Each digit d rotates by d * 36 degrees, accumulating a spiral
angles <- cumsum(pi_digits * (2 * pi / 10))
radii  <- seq(0.1, 10, length.out = n)
x <- radii * cos(angles)
y <- radii * sin(angles)
df <- data.frame(
x     = x,
y     = y,
digit = factor(pi_digits),
idx   = seq_len(n)
)
# --- Plot ---
ggplot(df, aes(x, y, color = digit, size = 1 / (idx^0.3))) +
geom_path(aes(group = 1), color = "white", alpha = 0.08, linewidth = 0.3) +
geom_point(alpha = 0.85, shape = 16) +
scale_color_manual(values = c(
"0" = "#ff0055", "1" = "#ff6600", "2" = "#ffcc00",
"3" = "#00ff88", "4" = "#00ccff", "5" = "#0066ff",
"6" = "#9900ff", "7" = "#ff00cc", "8" = "#ff99aa",
"9" = "#aaffee"
)) +
scale_size_continuous(range = c(0.3, 2.5), guide = "none") +
coord_equal() +
labs(
title    = "π  G A L A X Y",
subtitle = "Each point is a digit of π · color = digit value · spiral = cumulative angle",
color    = "Digit",
caption  = "π = 3.14159265358979..."
) +
theme_void(base_family = "mono") +
theme(
plot.background  = element_rect(fill = "#050510", color = NA),
panel.background = element_rect(fill = "#050510", color = NA),
plot.title    = element_text(color = "#ffffff", size = 28,
hjust = 0.5, face = "bold",
margin = margin(t = 20, b = 4)),
plot.subtitle = element_text(color = "#8888bb", size = 9,
hjust = 0.5,
margin = margin(b = 10)),
plot.caption  = element_text(color = "#555577", size = 8, hjust = 0.5),
legend.text   = element_text(color = "#cccccc"),
legend.title  = element_text(color = "#aaaacc"),
plot.margin   = margin(20, 20, 20, 20)
)
pi_digits <- c(3,1,4,1,5,9,2,6,5,3,5,8,9,7,9,3,2,3,8,4,6)
n <- length(pi_digits)
# Color palette: warm ember → cool ice
colors <- colorRampPalette(c("#ff2d55","#ff9500","#ffcc00",
"#34c759","#00c7be","#0a84ff","#bf5af2"))(n)
draw_pi_clock <- function(frame) {
par(bg = "#0a0a12", mar = c(0,0,0,0))
plot.new()
plot.window(xlim = c(-1,1), ylim = c(-1,1), asp = 1)
# Subtle grid glow rings
for (r in seq(0.15, 0.95, by = 0.1)) {
theta <- seq(0, 2*pi, length.out = 200)
lines(r*cos(theta), r*sin(theta), col = "#ffffff08", lwd = 1)
}
# Draw each digit as an arc on its own ring
for (i in seq_len(n)) {
d     <- pi_digits[i]
if (d == 0) next
radius   <- 0.12 + (i / n) * 0.82          # rings grow outward
lwd_val  <- 1.5 + (n - i) * 0.18           # inner rings thicker
arc_frac <- d / 10                          # digit → fraction of circle
# Animate: each ring rotates at its own speed
phase  <- (frame / 120) * 2 * pi * (0.3 + i * 0.07)
t_start <- phase
t_end   <- phase + arc_frac * 2 * pi
theta <- seq(t_start, t_end, length.out = max(3, round(d * 15)))
# Glow effect: draw 3 layers (wide+faint → narrow+bright)
for (glow in c(4, 2, 1)) {
alpha_hex <- c("22","55","ff")[4 - glow]
col_glow  <- paste0(colors[i], alpha_hex)
lines(radius * cos(theta), radius * sin(theta),
col = col_glow, lwd = lwd_val * glow * 0.7, lend = "round")
}
# Bright endpoint dot
points(radius * cos(t_end), radius * sin(t_end),
pch = 16, cex = 0.6 + d * 0.08, col = colors[i])
# Digit label on the ring
label_angle <- t_start - 0.15
text(radius * cos(label_angle), radius * sin(label_angle),
labels = as.character(d),
col = paste0(colors[i], "cc"),
cex = 0.45, font = 2)
}
# Center: π symbol
symbols(0, 0, circles = 0.09, inches = FALSE,
bg = "#1a1a2e", fg = "#ffffff30", add = TRUE, lwd = 1)
text(0, 0, "π", col = "#ffffff", cex = 2.2, font = 2,
family = "serif")
# Title
text(0, -1.0, "π  D I G I T  R I N G S", col = "#ffffff44",
cex = 0.55, font = 1, family = "mono")
text(0,  1.0, "3.14159265358979323846...", col = "#ffffff22",
cex = 0.42, family = "mono")
}
# --- Animate ---
frames <- 360
cat("Animating π clock... close the window to stop.\n")
for (frame in 1:(frames * 3)) {
dev.hold()
draw_pi_clock(frame)
dev.flush()
Sys.sleep(1/30)  # ~30 fps
}
