jac_of  <- function(A, B, Ctrue) safe_div(B + Ctrue - 2*A, B + Ctrue - A)
sym_of  <- function(A, B, Ctrue) safe_div(B + Ctrue - 2*A, 2*Ctrue)
prec_of <- function(A, B)        safe_div(A, B)
rec_of  <- function(A, Ctrue)    safe_div(A, Ctrue)
