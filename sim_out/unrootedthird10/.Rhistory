bootCO_A[[i]][j, yy] <- sum(as.numeric(BL[[i]][[yy+1]][[j]][,6]))
bootCO_B[[i]][j, yy] <- sum(BL[[i]][[yy+1]][[j]][,5] > 0)
if (has_hy) {
bootHy_A[[i]][j, yy] <- sum(as.numeric(BL[[i]][[yy+1]][[j]][BL[[i]][[yy+1]][[j]][,2]>4, 8]))
bootHy_B[[i]][j, yy] <- length(BL[[i]][[yy+1]][[j]][BL[[i]][[yy+1]][[j]][,2]>4, 7])
}
}
}
yy <- 2
if (BL[[i]][[yy+1]][[j]][1,1] != 'NA') {
tab <- BL[[i]][[yy+1]][[j]]
tab[is.na(tab)] <- 0
if (0 %in% tab[,3]) { tab <- merge_zero_rows(tab) }
rows_maj_blob <- tab[,4] > 0.5
bootblobs_A[[i]][j, 6] <- sum(as.numeric(tab[rows_maj_blob, 4])  )
bootblobs_B[[i]][j, 6] <- sum(tab[rows_maj_blob, 3] > 0)
rows_maj_CO <- tab[,7] > 0.5
bootCO_A[[i]][j, 6] <- sum(as.numeric(tab[rows_maj_blob, 6]))
bootCO_B[[i]][j, 6] <- sum(tab[rows_maj_CO, 5] > 0)
if (has_hy) {
sub_hy <- tab[tab[,2] > 4, , drop = FALSE]
rows_maj_hy <- sub_hy[,8] > 0.5
bootHy_A[[i]][j, 6] <- sum(as.numeric(sub_hy[rows_maj_hy, 8]))
bootHy_B[[i]][j, 6] <- sum(sub_hy[rows_maj_hy, 7] > 0)
}
} else {
if (has_hy) { bootHy_A[[i]][j, 5] <- 0; bootHy_B[[i]][j, 5] <- 0 }
}
}
true_blobs     <- BNN[[1]][i,]
true_hy  <- BNN[[2]][i,]
Ctrue_blobs_mat      <- matrix(true_blobs, 100, n_cat)
# Ctrue_blobs_mat[, 1] <- true_blobs_true
Ctrue_hy_mat         <- matrix(true_hy, 100, n_cat)
idx <- c(5,1,3,4,6,2)
## (TRUE, Squirrel, HMS, HWC, L1N-majority, L1N)
bootblobs_A[[i]] <- bootblobs_A[[i]][, idx]; bootblobs_B[[i]] <- bootblobs_B[[i]][, idx]
bootCO_A[[i]]    <- bootCO_A[[i]][, idx];    bootCO_B[[i]]    <- bootCO_B[[i]][, idx]
bootHy_A[[i]]    <- bootHy_A[[i]][, idx];    bootHy_B[[i]]    <- bootHy_B[[i]][, idx]
blobs_jac_net[i,]  <-colMeans(jac_of(bootblobs_A[[i]], bootblobs_B[[i]], Ctrue_blobs_mat),    na.rm = F)
CO_jac_net[i,]    <- colMeans(jac_of(bootCO_A[[i]],    bootCO_B[[i]],    Ctrue_blobs_mat),    na.rm = F)
Hy_jac_net[i,]    <- colMeans(jac_of(bootHy_A[[i]],    bootHy_B[[i]],    Ctrue_hy_mat),    na.rm = F)
blobs_sym_net[i,] <- colMeans(sym_of(bootblobs_A[[i]], bootblobs_B[[i]], Ctrue_blobs_mat),    na.rm = F)
CO_sym_net[i,]    <- colMeans(sym_of(bootCO_A[[i]],    bootCO_B[[i]],    Ctrue_blobs_mat),    na.rm = F)
Hy_sym_net[i,]    <- colMeans(sym_of(bootHy_A[[i]],    bootHy_B[[i]],    Ctrue_hy_mat),    na.rm = F)
blobs_prec_net[i,] <- colMeans(prec_of(bootblobs_A[[i]], bootblobs_B[[i]]),    na.rm = F)
CO_prec_net[i,]    <- colMeans(prec_of(bootCO_A[[i]],    bootCO_B[[i]]),    na.rm = F)
Hy_prec_net[i,]    <- colMeans(prec_of(bootHy_A[[i]],    bootHy_B[[i]]),    na.rm = F)
blobs_rec_net[i,] <- colMeans(rec_of(bootblobs_A[[i]], Ctrue_blobs_mat),    na.rm = F)
CO_rec_net[i,]   <-  colMeans(rec_of(bootCO_A[[i]],    Ctrue_blobs_mat),    na.rm = F)
Hy_rec_net[i,]   <-  colMeans(rec_of(bootHy_A[[i]],    Ctrue_hy_mat),    na.rm = F)
}
t1blobs_jac <- colMeans(blobs_jac_net, na.rm = F)
t1CO_jac    <- colMeans(CO_jac_net,    na.rm = F)
t1Hy_jac    <- colMeans(Hy_jac_net,    na.rm = F)
t1Mn_jac    <- (t1blobs_jac + t1CO_jac + t1Hy_jac + t1Sp_jac) / 4
