has_hy <- truen_num_blobs_ge4 > 0
yy <- 0
if (BL[[i]][[yy+1]][[j]][1,1] == 'NA') {
if (has_hy) { bootHy_A[[i]][j, yy+5] <- 0; bootHy_B[[i]][j, yy+5] <- 0 }
} else {
BL[[i]][[yy+1]][[j]][is.na(BL[[i]][[yy+1]][[j]])] <- 0
bootblobs_A[[i]][j, yy+5] <- sum(as.numeric(BL[[i]][[yy+1]][[j]][,4]))
bootblobs_B[[i]][j, yy+5] <- sum(BL[[i]][[yy+1]][[j]][,3] > 0)
bootCO_A[[i]][j, yy+5] <- sum(as.numeric(BL[[i]][[yy+1]][[j]][,6]))
bootCO_B[[i]][j, yy+5] <- sum(BL[[i]][[yy+1]][[j]][,5] > 0)
if (has_hy) {
bootHy_A[[i]][j, yy+5] <- sum(as.numeric(BL[[i]][[yy+1]][[j]][BL[[i]][[yy+1]][[j]][,2]>4, 8]))
bootHy_B[[i]][j, yy+5] <- length(BL[[i]][[yy+1]][[j]][BL[[i]][[yy+1]][[j]][,2]>4, 7])
