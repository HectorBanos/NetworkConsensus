jaccard_tree_dist <- function(tree1, tree2) {
# require same taxon set
if (!setequal(tree1$tip.label, tree2$tip.label)) {
stop("Trees must have the same set of tip labels")
}
pp <- prop.part(tree1, tree2)     # unique splits across both trees
n  <- attr(pp, "number")          # 1 or 2: how many trees contain each split
intersection <- sum(n == 2)
union_size   <- length(n)
jaccard_sim  <- intersection / union_size
1 - jaccard_sim                   # Jaccard distance
}
