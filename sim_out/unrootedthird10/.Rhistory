CO_jac_net     <- matrix(0, nrow = 20, ncol = 6)
Hy_jac_net     <- matrix(0, nrow = 20, ncol = 6)
blobs_sym_net  <- matrix(0, nrow = 20, ncol = 6)
CO_sym_net     <- matrix(0, nrow = 20, ncol = 6)
Hy_sym_net     <- matrix(0, nrow = 20, ncol = 6)
