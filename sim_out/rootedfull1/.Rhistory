if(L[[i]][[yy+1]][1,1]=='NA'){
t2blobs_a[yy] = t2blobs_a[yy] + 0
t2blobs_c[yy] = t2blobs_c[yy] + 1*truen_num_blobs*100
t1blobs_a[yy] = t1blobs_a[yy] + 0
t1blobs_c[yy] = t1blobs_c[yy] + 1*truen_num_blobs*100
t1blobs_b[yy] = t1blobs_b[yy] + 0
t2CO_a[yy] = t2CO_a[yy] + 0
t2CO_c[yy] = t2CO_c[yy] + 1*truen_num_blobs*100
t1CO_a[yy] = t1CO_a[yy] + 0
t1CO_c[yy] = t1CO_c[yy] + 1*truen_num_blobs*100
t1CO_b[yy] = t1CO_b[yy] + 0
if(truen_num_blobs_ge4 > 0)
{
t2Hy_a[yy] = t2Hy_a[yy] + 0
t2Hy_c[yy] = t2Hy_c[yy] + 1*truen_num_blobs_ge4*100
t1Hy_b[yy] = t1Hy_b[yy] + 1*0
t1Hy_c[yy] = t1Hy_c[yy] + 1*truen_num_blobs_ge4*100
}
} else {
L[[i]][[yy+1]][is.na(L[[i]][[yy+1]])] <- 0
if(0%in%L[[i]][[yy+1]][,3])
{
L[[i]][[yy+1]] <- merge_zero_rows(L[[i]][[yy+1]])
}
t1blobs_a[yy] = t1blobs_a[yy] +   sum(as.numeric(L[[i]][[yy+1]][,4]) * as.numeric(L[[i]][[yy+1]][,9]>0) )*100
t1blobs_c[yy] = t1blobs_c[yy] + 1*truen_num_blobs*100
t1blobs_b[yy] = t1blobs_b[yy] + 1*sum(L[[i]][[yy+1]][,9]>0) *100
t2blobs_a[yy] = t2blobs_a[yy] +   sum(as.numeric(L[[i]][[yy+1]][,4]) * as.numeric(L[[i]][[yy+1]][,9]>0) )*100
t2blobs_c[yy] = t2blobs_c[yy] + 1*truen_num_blobs*100
t1CO_a[yy] = t1CO_a[yy] +   sum(as.numeric(L[[i]][[yy+1]][,7]) )*100
t1CO_c[yy] = t1CO_c[yy] + 1*truen_num_blobs*100
t1CO_b[yy] = t1CO_b[yy] + 1*sum(L[[i]][[yy+1]][,6]>0)*100
t2CO_a[yy] = t2CO_a[yy] +   sum(as.numeric(L[[i]][[yy+1]][,7]) )*100
t2CO_c[yy] = t2CO_c[yy] + 1*truen_num_blobs*100
if(truen_num_blobs_ge4 > 0)
{
t1Hy_a[yy] = t1Hy_a[yy] +  sum( as.numeric(L[[i]][[yy+1]][L[[i]][[yy+1]][,2]>4, 10]) )*100
t1Hy_c[yy] = t1Hy_c[yy] + 1*truen_num_blobs_ge4*100
t1Hy_b[yy] = t1Hy_b[yy] + 1*sum(L[[i]][[yy+1]][L[[i]][[yy+1]][,2]>4, 9]>0)*100
t2Hy_a[yy] = t2Hy_a[yy] +   sum( as.numeric(L[[i]][[yy+1]][L[[i]][[yy+1]][,2]>4, 10]) )*100
t2Hy_c[yy] = t2Hy_c[yy] + 1*truen_num_blobs_ge4*100
}
}
}
## ---- slot 6: L1N-majority ----
yy <- 2
if(L[[i]][[yy+1]][1,1] != 'NA') {
tab <- L[[i]][[yy+1]]
tab[is.na(tab)] <- 0
if(0 %in% tab[,3]) { tab <- merge_zero_rows(tab) }
rows_maj_blob <- tab[,4] > 0.5
t1blobs_a[6] = t1blobs_a[6] + sum(as.numeric(tab[rows_maj_blob, 4]) * as.numeric(tab[rows_maj_blob, 9]>0))*100
t1blobs_c[6] = t1blobs_c[6] + 1*truen_num_blobs*100
t1blobs_b[6] = t1blobs_b[6] + 1*sum(tab[rows_maj_blob, 9]>0)*100
rows_maj_CO <- tab[,7] > 0.5
t1CO_a[6] = t1CO_a[6] + sum(as.numeric(tab[rows_maj_CO, 7]))*100
t1CO_c[6] = t1CO_c[6] + 1*truen_num_blobs*100
t1CO_b[6] = t1CO_b[6] + 1*sum(tab[rows_maj_CO, 6]>0)*100
if(truen_num_blobs_ge4 > 0) {
sub_hy <- tab[tab[,2]>4, , drop=FALSE]
rows_maj_hy <- sub_hy[,10] > 0.5
t1Hy_a[6] = t1Hy_a[6] + sum(as.numeric(sub_hy[rows_maj_hy, 10]))*100
t1Hy_c[6] = t1Hy_c[6] + 1*truen_num_blobs_ge4*100
t1Hy_b[6] = t1Hy_b[6] + 1*sum(sub_hy[rows_maj_hy, 9]>0)*100
}
} else {
t1blobs_c[6] = t1blobs_c[6] + 1*truen_num_blobs*100
t1CO_c[6]    = t1CO_c[6]    + 1*truen_num_blobs*100
if(truen_num_blobs_ge4 > 0) t1Hy_c[6] = t1Hy_c[6] + 1*truen_num_blobs_ge4*100
}
}
idx = c(5,1,3,4,6,2)
## --- Jaccard Index ---
t1blobs_jac = 1 -(t1blobs_b[idx]+rep(sum(NN[,1]),6)-2*t1blobs_a[idx]) / (t1blobs_b[idx]+rep(sum(NN[,1]),6) -t1blobs_a[idx])
t1CO_jac    = 1 -(t1CO_b[idx]+   rep(sum(NN[,1]),6) -2*t1CO_a[idx]) /   (t1CO_b[idx]+rep(sum(NN[,1]),6) -t1CO_a[idx])
t1Hy_jac    = 1 -(t1Hy_b[idx]+   rep(sum(NN[,2]),6) -2*t1Hy_a[idx]) /   (t1Hy_b[idx]+rep(sum(NN[,2]),6) -t1Hy_a[idx])
t1Sp_jac    = 1 - ( 1- (t1Sp_a)/(t1Sp_a+t1Sp_b+t1Sp_c) )[idx]
t1Mn_jac    = (t1blobs_jac + t1CO_jac + t1Hy_jac + t1Sp_jac) / 4
## --- Symmetric difference: raw mismatch count (b+c-2a), UNNORMALIZED.
## No division by 2*c or 2*(a+b) -- these are now on different absolute
## scales per measure (Blobs/CO/Hy/Splits), so t1Mn_sym is an average of
## raw counts, not a normalized rate like the other Mn panels. ---
t1blobs_sym = t1blobs_b[idx] + rep(sum(NN[,1]),6) - 2*t1blobs_a[idx]
t1CO_sym    = t1CO_b[idx]    + rep(sum(NN[,1]),6) - 2*t1CO_a[idx]
t1Hy_sym    = t1Hy_b[idx]    + rep(sum(NN[,2]),6) - 2*t1Hy_a[idx]
t1Sp_sym    = t1Sp_b[idx]    + t1Sp_c[idx]        - 2*t1Sp_a[idx]
t1Mn_sym    = (t1blobs_sym + t1CO_sym + t1Hy_sym + t1Sp_sym) / 4
## --- Symmetric difference: raw mismatch count (b+c-2a), UNNORMALIZED.
## No division by 2*c or 2*(a+b) -- these are now on different absolute
## scales per measure (Blobs/CO/Hy/Splits), so t1Mn_sym is an average of
## raw counts, not a normalized rate like the other Mn panels. ---
t1blobs_sym = (t1blobs_b[idx] + rep(sum(NN[,1]),6) - 2*t1blobs_a[idx])/100
t1CO_sym    = (t1CO_b[idx]    + rep(sum(NN[,1]),6) - 2*t1CO_a[idx])/100
t1Hy_sym    = ( t1Hy_b[idx]    + rep(sum(NN[,2]),6) - 2*t1Hy_a[idx])/100
t1blobs_sym
t1CO_sym
t1Hy_sym
t1Sp_sym
t1Sp_b[idx]
t1Sp_c[idx]
t1Sp_a[idx]
library(ape)
library(SiPhyNetwork)
library(grid)
library(gridExtra)
library(TreeDist)
library(MSCquartets)
library('Quartet')
base_dir <- "~/Library/CloudStorage/OneDrive-CaliforniaStateUniversitySanBernardino/Documents/ToBolivier/R/Pipeline/CleanPipeline-final"
source(paste0(base_dir,"/auxfiles/Finalcode_bootsupport.R"))
n_reps <- 1
degree3_split_names <- function(tree) {
if (is.null(tree$edge) || nrow(tree$edge) == 0) return(character(0))
n_tips <- length(tree$tip.label)
if (n_tips < 3) return(character(0))
## Degree of every node
deg <- table(c(tree$edge[, 1], tree$edge[, 2]))
## For each edge, get degrees of both endpoints
edge_deg_parent <- as.integer(deg[as.character(tree$edge[, 1])])
edge_deg_child  <- as.integer(deg[as.character(tree$edge[, 2])])
## An edge qualifies if BOTH endpoints are degree 3
edge_ok <- isTRUE(edge_deg_parent == 3) & isTRUE(edge_deg_child == 3)
## Vectorised: compare element-wise
edge_ok <- (edge_deg_parent == 3) & (edge_deg_child == 3)
edge_ok[is.na(edge_ok)] <- FALSE
## Build the tip-set below each child node (i.e. each edge defines a split
## = tips below child vs everything else)
descendants <- vector("list", max(tree$edge))
for (i in seq_len(n_tips)) descendants[[i]] <- i
for (i in rev(seq_len(nrow(tree$edge)))) {
p <- tree$edge[i, 1]; ch <- tree$edge[i, 2]
descendants[[p]] <- unique(c(descendants[[p]], descendants[[ch]]))
}
## For each qualifying edge, produce a canonical split name
## (sorted tip names on the smaller side, separated by commas)
split_names <- character(0)
for (e in seq_len(nrow(tree$edge))) {
if (!edge_ok[e]) next
child_node <- tree$edge[e, 2]
## skip tip edges (child is a tip — degree 1, already filtered by edge_ok,
## but guard anyway)
if (child_node <= n_tips) next
desc <- descendants[[child_node]]
other <- setdiff(seq_len(n_tips), desc)
## canonical: use the smaller side, sorted
side <- if (length(desc) <= length(other)) desc else other
nm   <- paste(sort(tree$tip.label[side]), collapse = ",")
split_names <- c(split_names, nm)
}
unique(split_names)
}
edge_dist <- function(tree, boot_tree) {
names1 <- degree3_split_names(tree)
names2 <- degree3_split_names(boot_tree)
a <- length(intersect(names1, names2))
b <- length(setdiff(names1, names2))
c <- length(setdiff(names2, names1))
c(a, b, c)
}
## Returns c(jaccard_distance, a, b, c). Symmetric-difference distance can be
## derived from the SAME call as result[3] + result[4] (i.e. b + c), so we
## never need to recompute degree3_split_names separately for that metric.
jaccard_tree_dist <- function(tree1, tree2) {
names1     <- degree3_split_names(tree1)
names2     <- degree3_split_names(tree2)
a          <- length(intersect(names1, names2))
b          <- length(setdiff(names1, names2))
c          <- length(setdiff(names2, names1))
union_size <- length(union(names1, names2))
if (union_size == 0) return(c(0, a, b, c))
c( 1 - a / union_size,a,b,c)
}
edge_supp <- function(tree, boot_trees) {
names1 <- degree3_split_names(tree)
edges  <- rep(0, length(names1))
for (j in seq_along(names1)) {
nam <- names1[j]
for (i in seq_along(boot_trees)) {
names2   <- degree3_split_names(boot_trees[[i]])
edges[j] <- (nam %in% names2) + edges[j]
}
}
names1[which(edges > 50)]
}
RF.DIFM.jaccard <- function(boot_tree, tree, boot_trees) {
names2     <- edge_supp(tree, boot_trees)
names1     <- degree3_split_names(boot_tree)
a          <- length(intersect(names1, names2))
b          <- length(setdiff(names1, names2))
c          <- length(setdiff(names2, names1))
union_size <- a + b + c
jaccard_dist <- if (union_size == 0) 0 else (b + c) / union_size
c(jaccard_dist, a, b, c)
}
RF.DIFM <- function(boot_tree, tree, boot_trees) {
names2  <- edge_supp(tree, boot_trees)
names1  <- degree3_split_names(boot_tree)
matches <- intersect(names1, names2)
a <- length(matches)
b <- length(setdiff(names1, names2))
c <- length(setdiff(names2, names1))
c(length(names1) + length(names2) - 2*a, a, b, c)
}
