flag1  <- 1
hwLvl1 <- readLines(paste0(location, '/HWC_outgroup_full_Net', xx, '.txt'))
if (str_detect(hwLvl1, "#")) {
hwLvl1 <- read.evonet(text = hwLvl1)
} else {
hwLvl1 <- read.tree(text = hwLvl1); flag1 <- 0
}
sqLvl1 <- read.nets(file = paste0(location,
'/rooted_network_newick_concatalignRealisticSim_400gts_Net', xp, '.txt'))[1][[1]]
sToB  <- treeOfBlobs(sLvl1)
if (flag  == 1) { hToB  <- treeOfBlobs(hLvl1)  } else { hToB  <- unroot(hLvl1)  }
if (flag1 == 1) { hwToB <- treeOfBlobs(hwLvl1) } else { hwToB <- unroot(hwLvl1) }
sqToB <- treeOfBlobs(sqLvl1)
sToB$edge.length <- rep(1, length(sToB$edge.length))
sboot_sampled_lvl1 <- read.nets(file = paste0(location,
'/rooted_network_newick_concatalignRealisticSim_400gts_Net', xp, '.txt'))[2:101]
sboot_sampled_tob  <- list()
for (i in 1:100) {
flag <- 1
if (is.null(sboot_sampled_lvl1[[i]]$reticulation)) { flag <- 0 }
if (flag == 1) {
sboot_sampled_tob[[i]] <- treeOfBlobs(sboot_sampled_lvl1[[i]])
} else {
sboot_sampled_tob[[i]] <- sboot_sampled_lvl1[[i]]
}
}
## --- single call per pair; extract BOTH the Jaccard distance (idx 1)
## and the symmetric-difference distance (idx 3 + idx 4 = b + c) ---
s_res  <- jaccard_tree_dist(TrueToB, sToB)
sq_res <- jaccard_tree_dist(TrueToB, sqToB)
h_res  <- jaccard_tree_dist(TrueToB, hToB)
hw_res <- jaccard_tree_dist(TrueToB, hwToB)
m_res  <- RF.DIFM.jaccard(TrueToB, sToB, sboot_sampled_tob)
srf  <- s_res[1];  srf_sym  <- s_res[3]  + s_res[4]
sqrf <- sq_res[1]; sqrf_sym <- sq_res[3] + sq_res[4]
hrf  <- h_res[1];  hrf_sym  <- h_res[3]  + h_res[4]
hwrf <- hw_res[1]; hwrf_sym <- hw_res[3] + hw_res[4]
mrf  <- m_res[1];  mrf_sym  <- m_res[3]  + m_res[4]
## --- branch counts (unfiltered: raw topology summary) ---
# numbran   <- dim(TrueToB$edge)[1] - 21
# numbrans  <- dim(sToB$edge)[1]    - 21
# numbransq <- dim(sqToB$edge)[1]   - 21
# numbranh  <- dim(hToB$edge)[1]    - 21
# numbranhw <- dim(hwToB$edge)[1]   - 21
# numbranm  <- length(edge_supp(sToB, sboot_sampled_tob))
#
numbran   <- length(degree3_split_names(TrueToB) )
numbrans  <-  length(degree3_split_names(sToB) )
numbransq <-  length(degree3_split_names(sqToB) )
numbranh  <-  length(degree3_split_names(hToB) )
numbranhw <-  length(degree3_split_names(hwToB) )
numbranm  <-  length(edge_supp(sToB, sboot_sampled_tob))
degree3_split_names
## --- edge-set distances (degree-3 edges only); identical for both
## metrics since a/b/c don't depend on how the scalar distance is formed ---
sed  <- edge_dist(TrueToB, sToB)
sqed <- edge_dist(TrueToB, sqToB)
hed  <- edge_dist(TrueToB, hToB)
hwed <- edge_dist(TrueToB, hwToB)
med  <- m_res[2:4]
srfbs  <- 0; sqrfbs  <- 0; hrfbs  <- 0; hwrfbs  <- 0; mrfbs  <- 0; Trfbs  <- 0
srfbs_sym <- 0; sqrfbs_sym <- 0; hrfbs_sym <- 0; hwrfbs_sym <- 0; mrfbs_sym <- 0; Trfbs_sym <- 0
Trfbs_a <- 0; Trfbs_b <- 0; Trfbs_c <- 0;
srfbs_a <- 0; srfbs_b <- 0; srfbs_c <- 0;
sqrfbs_a <- 0; sqrfbs_b <- 0; sqrfbs_c <- 0;
hrfbs_a <- 0; hrfbs_b <- 0; hrfbs_c <- 0;
hwrfbs_a <- 0; hwrfbs_b <- 0; hwrfbs_c <- 0;
mrfbs_a <- 0; mrfbs_b <- 0; mrfbs_c <- 0;
avgnmbranches <- 0
i=1
s_bs_res  <- jaccard_tree_dist(  sToB,sboot_sampled_tob[[i]])
sq_bs_res <- jaccard_tree_dist(  sqToB,sboot_sampled_tob[[i]])
h_bs_res  <- jaccard_tree_dist(  hToB,sboot_sampled_tob[[i]])
hw_bs_res <- jaccard_tree_dist(  hwToB,sboot_sampled_tob[[i]])
m_bs_res  <- RF.DIFM.jaccard(  sToB,sboot_sampled_tob[[i]], sboot_sampled_tob)
T_bs_res  <- jaccard_tree_dist(  TrueToB,sboot_sampled_tob[[i]])
srfbs  <- s_bs_res[1]  / 100 + srfbs
sqrfbs <- sq_bs_res[1] / 100 + sqrfbs
hrfbs  <- h_bs_res[1]  / 100 + hrfbs
hwrfbs <- hw_bs_res[1] / 100 + hwrfbs
mrfbs  <- m_bs_res[1]  / 100 + mrfbs
Trfbs  <- T_bs_res[1]  / 100 + Trfbs
srfbs_sym  <- (s_bs_res[3]  + s_bs_res[4])  / 100 + srfbs_sym
sqrfbs_sym <- (sq_bs_res[3] + sq_bs_res[4]) / 100 + sqrfbs_sym
hrfbs_sym  <- (h_bs_res[3]  + h_bs_res[4])  / 100 + hrfbs_sym
hwrfbs_sym <- (hw_bs_res[3] + hw_bs_res[4]) / 100 + hwrfbs_sym
mrfbs_sym  <- (m_bs_res[3]  + m_bs_res[4])  / 100 + mrfbs_sym
Trfbs_sym  <- (T_bs_res[3]  + T_bs_res[4])  / 100 + Trfbs_sym
avgnmbranches <- (dim(sboot_sampled_tob[[i]]$edge)[1]-21)/100    + avgnmbranches
Trfbs_a  <- T_bs_res[2] / 100 + Trfbs_a
Trfbs_b  <- T_bs_res[3] / 100 + Trfbs_b
Trfbs_c  <- T_bs_res[4] / 100 + Trfbs_c
Trfbs_a
Trfbs_b
Trfbs_c
t1Sp_sym    = t1Sp_b[idx]    + t1Sp_c[idx]       # - 2*t1Sp_a[idx]
t1Sp_sym
## --- Symmetric difference: raw mismatch count (b+c-2a), UNNORMALIZED.
## No division by 2*c or 2*(a+b) -- these are now on different absolute
## scales per measure (Blobs/CO/Hy/Splits), so t1Mn_sym is an average of
## raw counts, not a normalized rate like the other Mn panels. ---
t1blobs_sym = (t1blobs_b[idx] + rep(sum(NN[,1]),6) - 2*t1blobs_a[idx])/100
t1CO_sym    = (t1CO_b[idx]    + rep(sum(NN[,1]),6) - 2*t1CO_a[idx])/100
t1Hy_sym    = ( t1Hy_b[idx]    + rep(sum(NN[,2]),6) - 2*t1Hy_a[idx])/100
t1Sp_sym    = t1Sp_b[idx]    + t1Sp_c[idx]       # - 2*t1Sp_a[idx]
t1Mn_sym    = (t1blobs_sym + t1CO_sym + t1Hy_sym + t1Sp_sym) / 4
t1blobs_sym
t1CO_sym
t1Hy_sym
t1Sp_sym
t1Mn_sym
## --- Symmetric difference: raw mismatch count (b+c-2a), UNNORMALIZED.
## No division by 2*c or 2*(a+b) -- these are now on different absolute
## scales per measure (Blobs/CO/Hy/Splits), so t1Mn_sym is an average of
## raw counts, not a normalized rate like the other Mn panels. ---
t1blobs_sym = (t1blobs_b[idx] + rep(sum(NN[,1]),6) - 2*t1blobs_a[idx])/2000
t1CO_sym    = (t1CO_b[idx]    + rep(sum(NN[,1]),6) - 2*t1CO_a[idx])/2000
t1Hy_sym    = ( t1Hy_b[idx]    + rep(sum(NN[,2]),6) - 2*t1Hy_a[idx])/2000
t1Sp_sym    = (t1Sp_b[idx]    + t1Sp_c[idx] )/20      # - 2*t1Sp_a[idx]
t1Sp_sym
t1blobs_sym
t1CO_sym
t1Hy_sym
t1Sp_sym
t1Mn_sym    = (t1blobs_sym + t1CO_sym + t1Hy_sym + t1Sp_sym) / 4
t1Mn_sym
