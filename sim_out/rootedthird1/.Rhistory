blobs_jac_true[i,]  <-colMeans(jac_of(bootblobs_A[[i]], bootblobs_B[[i]], true_blobs_true[i]),    na.rm = F)
CO_jac_true[i,]    <- colMeans(jac_of(bootCO_A[[i]],    bootCO_B[[i]],     true_blobs_true[i]),    na.rm = F)
blobs_jac_true[i,]
colMeans(jac_of(bootblobs_A[[i]], bootblobs_B[[i]], true_blobs_true[i]),    na.rm = F)
n_net <-20
n_cat <- 4
bootblobs_A <- list(); bootblobs_B <- list()
bootCO_A    <- list(); bootCO_B    <- list()
bootHy_A    <- list(); bootHy_B    <- list()
safe_div <- function(num, den) {
num[is.na(num)] <- 0
den[is.na(den)] <- 0
ifelse(num != 0 & den == 0,
1,
ifelse(num == 0 & den == 0,
0,
num / den))
}
jac_of  <- function(A, B, Ctrue) safe_div(B + Ctrue - 2*A, B + Ctrue - A)
sym_of  <- function(A, B, Ctrue) safe_div(B + Ctrue - 2*A, 2*Ctrue)
prec_of <- function(A, B)        safe_div(A, B)
rec_of  <- function(A, Ctrue)    safe_div(A, Ctrue)
Sp_jac_net   <-  matrix(0, nrow = 20, ncol = 4)
Sp_jac_true   <-  matrix(0, nrow = 20, ncol = 4)
Sp_sym_net   <- matrix(0, nrow = n_net, ncol = n_cat)
Sp_sym_true  <- matrix(0, nrow = n_net, ncol = n_cat)
Sp_prec_net  <- matrix(0, nrow = n_net, ncol = n_cat)
Sp_rec_net   <- matrix(0, nrow = n_net, ncol = n_cat)
Sp_f1_net    <- matrix(0, nrow = n_net, ncol = n_cat)
blobs_jac_net  <- matrix(0, nrow = n_net, ncol = n_cat)
CO_jac_net     <- matrix(0, nrow = n_net, ncol = n_cat)
Hy_jac_net     <- matrix(0, nrow = n_net, ncol = n_cat)
blobs_jac_net  <- matrix(0, nrow = 20, ncol = n_cat)
CO_jac_net     <- matrix(0, nrow = 20, ncol = n_cat)
Hy_jac_net     <- matrix(0, nrow = 20, ncol = n_cat)
blobs_sym_net  <- matrix(0, nrow = n_net, ncol = n_cat)
CO_sym_net     <- matrix(0, nrow = n_net, ncol = n_cat)
Hy_sym_net     <- matrix(0, nrow = n_net, ncol = n_cat)
blobs_sym_true <- matrix(0, nrow = n_net, ncol = n_cat)
CO_sym_true    <- matrix(0, nrow = n_net, ncol = n_cat)
Hy_sym_true    <- matrix(0, nrow = n_net, ncol = n_cat)
blobs_prec_net <- matrix(0, nrow = n_net, ncol = n_cat)
CO_prec_net    <- matrix(0, nrow = n_net, ncol = n_cat)
Hy_prec_net    <- matrix(0, nrow = n_net, ncol = n_cat)
blobs_rec_net  <- matrix(0, nrow = n_net, ncol = n_cat)
CO_rec_net     <- matrix(0, nrow = n_net, ncol = n_cat)
Hy_rec_net     <- matrix(0, nrow = n_net, ncol = n_cat)
blobs_f1_net   <- matrix(0, nrow = n_net, ncol = n_cat)
CO_f1_net      <- matrix(0, nrow = n_net, ncol = n_cat)
Hy_f1_net      <- matrix(0, nrow = n_net, ncol = n_cat)
true_blobs_true <- c()
true_hy_true    <- c()
for (i in 1:n_net) {
truen_num_blobs      <- length(LU[[i]][[1]][,1])
truen_num_blobs_ge4  <- length(LU[[i]][[1]][LU[[i]][[1]][, 2] > 4, 8])
true_blobs_true[i] <- truen_num_blobs
true_hy_true[i]    <- truen_num_blobs_ge4
bootblobs_A[[i]] <- matrix(0, 100, n_cat); bootblobs_B[[i]] <- matrix(0,  100, n_cat)
bootCO_A[[i]]    <- matrix(0, 100, n_cat); bootCO_B[[i]]    <- matrix(0,  100, n_cat)
bootHy_A[[i]]    <- matrix(0, 100, n_cat); bootHy_B[[i]] <- matrix(0, 100, n_cat)
for (j in 1:100) {
truen_num_blobs_j      <- BNNU[[1]][i,j]
truen_num_blobs_ge4_j  <- BNNU[[2]][i,j]
has_hy <- truen_num_blobs_ge4_j > 0
## ---- slot 3: TRUE (yy = 0) ----
## A from the per-replicate table BLU, B from the cleaned LU table
yy <- 0
if (BLU[[i]][[yy+1]][[j]][1,1] == 'NA') {
if (has_hy) { bootHy_A[[i]][j, yy+3] <- 0; bootHy_B[[i]][j, yy+3] <- 0 }
} else {
BLU[[i]][[yy+1]][[j]][is.na(BLU[[i]][[yy+1]][[j]])] <- 0
LU[[i]][[yy+1]][is.na(LU[[i]][[yy+1]])] <- 0
LU[[i]][[yy+1]] <- merge_zero_rows(LU[[i]][[yy+1]])
bootblobs_A[[i]][j, yy+3] <- sum(as.numeric(BLU[[i]][[yy+1]][[j]][,4]))
bootblobs_B[[i]][j, yy+3] <- sum(LU[[i]][[yy+1]][,2] > 0)
bootCO_A[[i]][j, yy+3] <- sum(as.numeric(BLU[[i]][[yy+1]][[j]][,6]))
bootCO_B[[i]][j, yy+3] <- sum(LU[[i]][[yy+1]][,2] > 0)
if (has_hy) {
bootHy_A[[i]][j, yy+3] <- min(sum(as.numeric(BLU[[i]][[yy+1]][[j]][BLU[[i]][[yy+1]][[j]][,2]>4, 8])), truen_num_blobs_ge4_j)
bootHy_B[[i]][j, yy+3] <- sum(LU[[i]][[yy+1]][,2] > 4)
}
}
## ---- slots 1, 2: Squirrel, L1N-unrooted (yy = 1, 2) ----
for (yy in 1:2) {
if (BLU[[i]][[yy+1]][[j]][1,1] == 'NA') {
if (has_hy) { bootHy_A[[i]][j, yy] <- 0; bootHy_B[[i]][j, yy] <- 0 }
} else {
BLU[[i]][[yy+1]][[j]][is.na(BLU[[i]][[yy+1]][[j]])] <- 0
LU[[i]][[yy+1]][is.na(LU[[i]][[yy+1]])] <- 0
LU[[i]][[yy+1]] <- merge_zero_rows(LU[[i]][[yy+1]])
bootblobs_A[[i]][j, yy] <- sum(as.numeric(BLU[[i]][[yy+1]][[j]][,4]))
bootblobs_B[[i]][j, yy] <- sum(LU[[i]][[yy+1]][,2] > 0)
bootCO_A[[i]][j, yy] <- sum(as.numeric(BLU[[i]][[yy+1]][[j]][,6]))
bootCO_B[[i]][j, yy] <- sum(LU[[i]][[yy+1]][,2] > 0)
if (has_hy) {
bootHy_A[[i]][j, yy] <- min(sum(as.numeric(BLU[[i]][[yy+1]][[j]][BLU[[i]][[yy+1]][[j]][,2]>4, 8])), truen_num_blobs_ge4_j)
bootHy_B[[i]][j, yy] <- sum(LU[[i]][[yy+1]][,9] > 0 & LU[[i]][[yy+1]][,2] > 4)
}
}
}
## ---- slot 4: L1N-unrooted-majority ----
## A from MAJ, B from the LU support columns (> 0.5).
## maj_src = 2 mirrors the rooted function (yy <- 1, i.e. L[[i]][[2]]).
maj_src <- 3
if (MAJ[[i]][[j]][1,1] == 'NA' || is.na(MAJ[[i]][[j]][1,1])) {
if (has_hy) { bootHy_A[[i]][j, 4] <- 0; bootHy_B[[i]][j, 4] <- 0 }
} else {
MAJ[[i]][[j]][is.na(MAJ[[i]][[j]])] <- 0
bootblobs_A[[i]][j, 4] <- sum(as.numeric(MAJ[[i]][[j]][,4]))
bootblobs_B[[i]][j, 4] <- sum(LU[[i]][[maj_src]][,4] > 0.5)
bootCO_A[[i]][j, 4] <- sum(as.numeric(MAJ[[i]][[j]][,6]))
bootCO_B[[i]][j, 4] <- sum(LU[[i]][[maj_src]][,7] > 0.5)
if (has_hy) {
bootHy_A[[i]][j, 4] <- min(sum(as.numeric(MAJ[[i]][[j]][MAJ[[i]][[j]][,2]>4, 8])), truen_num_blobs_ge4_j)
bootHy_B[[i]][j, 4] <- sum(as.numeric(LU[[i]][[maj_src]][,10]) > 0.5 & as.numeric(LU[[i]][[maj_src]][,2]) > 4)
}
}
}
true_blobs <- BNNU[[1]][i,]
true_hy    <- BNNU[[2]][i,]
Ctrue_blobs_mat      <- matrix(true_blobs, 100, n_cat)
# Ctrue_blobs_mat[, 1] <- true_blobs_true
Ctrue_hy_mat         <- matrix(true_hy, 100, n_cat)
idx <- c(3,1,4,2)
## (TRUE, Squirrel, L1N-unrooted-majority, L1N-unrooted)
bootblobs_A[[i]] <- bootblobs_A[[i]][, idx]; bootblobs_B[[i]] <- bootblobs_B[[i]][, idx]
bootCO_A[[i]]    <- bootCO_A[[i]][, idx];    bootCO_B[[i]]    <- bootCO_B[[i]][, idx]
bootHy_A[[i]]    <- bootHy_A[[i]][, idx];    bootHy_B[[i]]    <- bootHy_B[[i]][, idx]
blobs_jac_net[i,] <- colMeans(jac_of(bootblobs_A[[i]], bootblobs_B[[i]], Ctrue_blobs_mat), na.rm = F)
CO_jac_net[i,]    <- colMeans(jac_of(bootCO_A[[i]],    bootCO_B[[i]],    Ctrue_blobs_mat), na.rm = F)
Hy_jac_net[i,]    <- colMeans(jac_of(bootHy_A[[i]],    bootHy_B[[i]],    Ctrue_hy_mat),    na.rm = F)
Sp_jac_net[i,]    <- c(BMU[i, 38], BMU[i, 50], BMU[i, 56], BMU[i, 44])
blobs_jac_true[i,]  <-colMeans(jac_of(bootblobs_A[[i]], bootblobs_B[[i]], true_blobs_true[i]),    na.rm = F)
CO_jac_true[i,]    <- colMeans(jac_of(bootCO_A[[i]],    bootCO_B[[i]],     true_blobs_true[i]),    na.rm = F)
Hy_jac_true[i,]    <- colMeans(jac_of(bootHy_A[[i]],    bootHy_B[[i]],   true_hy_true[i]),    na.rm = F)
Sp_jac_true[i,]    <-c(BMU[i, 38], BMU[i, 50], BMU[i, 56], BMU[i, 44])
blobs_sym_net[i,] <- colMeans(sym_of(bootblobs_A[[i]], bootblobs_B[[i]], Ctrue_blobs_mat), na.rm = F)
CO_sym_net[i,]    <- colMeans(sym_of(bootCO_A[[i]],    bootCO_B[[i]],    Ctrue_blobs_mat), na.rm = F)
Hy_sym_net[i,]    <- colMeans(sym_of(bootHy_A[[i]],    bootHy_B[[i]],    Ctrue_hy_mat),    na.rm = F)
Sp_sym_net[i,]    <- c(BMU[i, 37], BMU[i, 49], BMU[i, 55], BMU[i, 43])
blobs_sym_true[i,] <- colMeans(sym_of(bootblobs_A[[i]], bootblobs_B[[i]], true_blobs_true[i]), na.rm = F)
CO_sym_true[i,]    <- colMeans(sym_of(bootCO_A[[i]],    bootCO_B[[i]],    true_blobs_true[i]), na.rm = F)
Hy_sym_true[i,]    <- colMeans(sym_of(bootHy_A[[i]],    bootHy_B[[i]],    true_hy_true[i]),    na.rm = F)
Sp_sym_true[i,]    <- c(BMU[i, 39], BMU[i, 51], BMU[i, 57], BMU[i, 45])
blobs_prec_net[i,] <- colMeans(prec_of(bootblobs_A[[i]], bootblobs_B[[i]]), na.rm = F)
CO_prec_net[i,]    <- colMeans(prec_of(bootCO_A[[i]],    bootCO_B[[i]]), na.rm = F)
Hy_prec_net[i,]    <- colMeans(prec_of(bootHy_A[[i]],    bootHy_B[[i]]), na.rm = F)
Sp_prec_net[i,]    <- c(BMU[i, 34], BMU[i, 46], BMU[i, 52], BMU[i, 40])
blobs_rec_net[i,] <- colMeans(rec_of(bootblobs_A[[i]], Ctrue_blobs_mat), na.rm = F)
CO_rec_net[i,]    <- colMeans(rec_of(bootCO_A[[i]],    Ctrue_blobs_mat), na.rm = F)
Hy_rec_net[i,]    <- colMeans(rec_of(bootHy_A[[i]],    Ctrue_hy_mat),    na.rm = F)
Sp_rec_net[i,]    <- c(BMU[i, 35], BMU[i, 47], BMU[i, 53], BMU[i, 41])
blobs_f1_net[i,] <- colMeans(f1_score(prec_of(bootblobs_A[[i]], Ctrue_blobs_mat), rec_of(bootblobs_A[[i]], Ctrue_blobs_mat) ),    na.rm = F)
CO_f1_net[i,]   <-  colMeans(f1_score(prec_of(bootCO_A[[i]], Ctrue_blobs_mat), rec_of(bootCO_A[[i]], Ctrue_blobs_mat) ),    na.rm = F)
Hy_f1_net[i,]   <-  colMeans(f1_score(prec_of(bootHy_A[[i]], Ctrue_hy_mat), rec_of(bootHy_A[[i]], Ctrue_hy_mat) ),    na.rm = F)
Sp_f1_net[i,]    <- c(BMU[i, 36], BMU[i, 48], BMU[i, 54], BMU[i, 42])
}
