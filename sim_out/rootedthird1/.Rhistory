set.seed(1)
L <- 2000000                       # number of sites
# Drift along one edge of length tau (Beta approximation)
drift <- function(p, tau) {
F <- 1 - exp(-tau)
out <- p
m <- p > 1e-9 & p < 1 - 1e-9     # leave fixed sites unchanged
out[m] <- rbeta(sum(m), p[m] * (1 - F) / F, (1 - p[m]) * (1 - F) / F)
out
}
# Simulate frequencies down the tree
p_root <- runif(L)
pX <- drift(p_root, 0.10)
pY <- drift(p_root, 0.15)
pA <- drift(pX, 0.05)
pB <- drift(pX, 0.05)
pC <- drift(pY, 0.05)
pD <- drift(pY, 0.10)
# f4 from allele frequencies
f4 <- function(a, b, c, d) mean((a - b) * (c - d))
print(c(f4_AB_CD = f4(pA, pB, pC, pD),
f4_AC_BD = f4(pA, pC, pB, pD),
f4_AD_BC = f4(pA, pD, pB, pC)))
# f4 from site patterns: one sequence per population
gA <- rbinom(L, 1, pA); gB <- rbinom(L, 1, pB)
gC <- rbinom(L, 1, pC); gD <- rbinom(L, 1, pD)
f4_patterns <- function(w, x, y, z) {
baba <- sum(w == y & x == z & w != x)
abba <- sum(w == z & x == y & w != x)
c(BABA = baba, ABBA = abba, f4 = (baba - abba) / length(w))
}
print(f4_patterns(gA, gB, gC, gD))   # f4(A, B; C, D)
print(f4_patterns(gA, gC, gB, gD))   # f4(A, C; B, D)
cat("\n===== Third of each gene =====\n"); third <- print_plotted(2)
gA
print(f4_patterns(gA, gB, gC, gD))   # f4(A, B; C, D)
print(f4_patterns(gA, gC, gB, gD))   # f4(A, C; B, D)
print(c(f4_AB_CD = f4(pA, pB, pC, pD),
f4_AC_BD = f4(pA, pC, pB, pD),
f4_AD_BC = f4(pA, pD, pB, pC)))
