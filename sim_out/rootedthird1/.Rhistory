print_metrics <- function(m, digits = 4) {
key <- c(
drfblobs_jac = "jacdist_blobs", drfCO_jac = "jacdist_CO", drfHy_jac = "jacdist_Hy",
drfSp_jac    = "jacdist_Sp",    drfMn_jac = "jacdist_Mn",
drfblobs_sym = "sym_blobs",     drfCO_sym = "sym_CO",     drfHy_sym = "sym_Hy",
drfSp_sym    = "sym_Sp",        drfMn_sym = "sym_Mn",
t1blobs = "prec_blobs", t1CO = "prec_CO", t1Hy = "prec_Hy", t1Sp = "prec_Sp", t1Mn = "prec_Mn",
t2blobs = "rec_blobs",  t2CO = "rec_CO",  t2Hy = "rec_Hy",  t2Sp = "rec_Sp",  t2Mn = "rec_Mn",
dblobs  = "f1_blobs",   dCO  = "f1_CO",   dHy  = "f1_Hy",   dSp  = "f1_Sp",   dMn  = "f1_Mn"
)
out <- setNames(m[names(key)], key)
out <- lapply(out, function(v) setNames(round(v, digits), category_levels[-1]))
print(out)
invisible(out)
}
cat("\n===== Full length =====\n");        full  <- print_metrics(avg_metrics[[1]])
print_plotted <- function(kk, digits = 4) {
metric_lab <- c(jac = "jacindex", sym = "sym", prec = "prec", rec = "rec", f1 = "f1")
feat_lab   <- c("blobs", "CO", "Hy", "Sp", "Mn")
out <- list()
for (m in names(metric_lab)) {
mat <- matrix(data_kk[[kk]][[m]], nrow = 5, byrow = TRUE,
dimnames = list(feat_lab, NULL))
mat <- mat[, KEEP, drop = FALSE]                    # drops Squirrel
for (f in feat_lab)
out[[paste0(metric_lab[[m]], "_", f)]] <- round(mat[f, ], digits)
}
print(out)
invisible(out)
}
cat("\n===== Full length =====\n");        full  <- print_plotted(1)
set.seed(1)
L <- 2000000                       # number of sites
# Drift along one edge of length tau (Beta approximation)
drift <- function(p, tau) {
F <- 1 - exp(-tau)
out <- p
m <- p > 1e-9 & p < 1 - 1e-9     # leave fixed sites unchanged
out[m] <- rbeta(sum(m), p[m] * (1 - F) / F, (1 - p[m]) * (1 - F) / F)
out
}
# Simulate frequencies down the tree
p_root <- runif(L)
pX <- drift(p_root, 0.10)
pC <- drift(p_root, 0.20)
pA <- drift(pX, 0.05)
pB <- drift(pX, 0.05)
# Statistics
f2 <- function(x, y) mean((x - y)^2)
f3 <- function(c, a, b) mean((c - a) * (c - b))
print(c(f2_AB = f2(pA, pB), f2_AC = f2(pA, pC), f2_BC = f2(pB, pC)))
print(c(f3_C_AB = f3(pC, pA, pB), f3_A_BC = f3(pA, pB, pC)))
pB
