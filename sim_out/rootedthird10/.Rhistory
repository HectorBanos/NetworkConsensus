## ---------------------------------------------------------------
## Helper: extract split names restricted to edges incident to a
## degree-3 node.
## ---------------------------------------------------------------
EDGE_MODE <- "all"
degree3_split_names <- function(tree, mode = EDGE_MODE) {
if (is.null(tree$edge) || nrow(tree$edge) == 0) return(character(0))
n_tips <- length(tree$tip.label)
if (n_tips < 3) return(character(0))
## Degree of every node
deg <- table(c(tree$edge[, 1], tree$edge[, 2]))
## For each edge, get degrees of both endpoints
edge_deg_parent <- as.integer(deg[as.character(tree$edge[, 1])])
edge_deg_child  <- as.integer(deg[as.character(tree$edge[, 2])])
edge_ok <- switch(mode,
"degree3" = {
ok <- (edge_deg_parent == 3) & (edge_deg_child == 3)
ok[is.na(ok)] <- FALSE
ok
},
"all" = rep(TRUE, nrow(tree$edge)),
stop("degree3_split_names: unknown mode '", mode,
"' -- use 'degree3' or 'all'")
)
## Build the tip-set below each child node (i.e. each edge defines a split
## = tips below child vs everything else)
descendants <- vector("list", max(tree$edge))
for (i in seq_len(n_tips)) descendants[[i]] <- i
for (i in rev(seq_len(nrow(tree$edge)))) {
p <- tree$edge[i, 1]; ch <- tree$edge[i, 2]
descendants[[p]] <- unique(c(descendants[[p]], descendants[[ch]]))
}
split_names <- character(0)
for (e in seq_len(nrow(tree$edge))) {
if (!edge_ok[e]) next
child_node <- tree$edge[e, 2]
## skip tip edges (child is a tip)
if (child_node <= n_tips) next
desc <- descendants[[child_node]]
other <- setdiff(seq_len(n_tips), desc)
side <- if (length(desc) <= length(other)) desc else other
nm   <- paste(sort(tree$tip.label[side]), collapse = ",")
split_names <- c(split_names, nm)
}
unique(split_names)
}
## Returns c(jaccard_distance, a, b, c). The symmetric-difference distance
## can be derived from the SAME call as result[3] + result[4] (i.e. b + c),
## so degree3_split_names never needs to be computed twice for that metric.
jaccard_tree_dist <- function(tree1, tree2) {
names1     <- degree3_split_names(tree1)
names2     <- degree3_split_names(tree2)
a          <- length(intersect(names1, names2))
b          <- length(setdiff(names1, names2))
c          <- length(setdiff(names2, names1))
union_size <- length(union(names1, names2))
if (union_size == 0) return(c(0, a, b, c))
c(1 - a / union_size, a, b, c)
}
edge_dist <- function(tree, boot_tree) {
names1 <- degree3_split_names(tree)
names2 <- degree3_split_names(boot_tree)
a <- length(intersect(names1, names2))
b <- length(setdiff(names1, names2))
c <- length(setdiff(names2, names1))
c(a, b, c)
}
edge_supp <- function(tree, boot_trees) {
names1 <- degree3_split_names(tree)
edges  <- rep(0, length(names1))
for (j in seq_along(names1)) {
nam <- names1[j]
for (i in seq_along(boot_trees)) {
names2   <- degree3_split_names(boot_trees[[i]])
edges[j] <- (nam %in% names2) + edges[j]
}
}
names1[which(edges > 50)]
}
RF.DIFM.jaccard <- function(boot_tree, tree, boot_trees) {
names2     <- edge_supp(tree, boot_trees)
names1     <- degree3_split_names(boot_tree)
a          <- length(intersect(names1, names2))
b          <- length(setdiff(names1, names2))
c          <- length(setdiff(names2, names1))
union_size <- a + b + c
jaccard_dist <- if (union_size == 0) 0 else (b + c) / union_size
c(jaccard_dist, a, b, c)
}
RF.DIFM <- function(boot_tree, tree, boot_trees) {
names2  <- edge_supp(tree, boot_trees)
names1  <- degree3_split_names(boot_tree)
a <- length(intersect(names1, names2))
b <- length(setdiff(names1, names2))
c <- length(setdiff(names2, names1))
c(length(names1) + length(names2) - 2*a, a, b, c)
}
## ---------------------------------------------------------------
## NEW: safe scalar division (0/0, x/0 -> NA) for the per-bootstrap
## precision/recall ratios computed below.
## ---------------------------------------------------------------
safe_ratio <- function(num, den) {
if (is.na(den) || den == 0) return(NA_real_)
num / den
}
## F1 helper: 2*P*R / (P + R), with 0/0 -> 0, NA propagates.
f1_ratio <- function(prec, rec) {
if (is.na(prec) || is.na(rec)) return(NA_real_)
if ((prec + rec) == 0) return(0)
2 * prec * rec / (prec + rec)
}
