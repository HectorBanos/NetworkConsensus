sToB$edge.length <- rep(1, length(sToB$edge.length))
sboot_sampled_lvl1 <- read.nets(file = paste0(location,
'/unrooted_network_newick_concatalignRealisticSim_400gts_Net', xp, '_third.txt'))[2:101]
sboot_sampled_tob  <- list()
for (i in 1:100) {
flag <- 1
if (is.null(sboot_sampled_lvl1[[i]]$reticulation)) { flag <- 0 }
if (flag == 1) {
sboot_sampled_tob[[i]] <- treeOfBlobs(sboot_sampled_lvl1[[i]])
} else {
sboot_sampled_tob[[i]] <- sboot_sampled_lvl1[[i]]
}
}
## --- single call per pair; extract BOTH the Jaccard distance (idx 1)
## and the symmetric-difference distance (idx 3 + idx 4 = b + c) ---
s_res  <- jaccard_tree_dist(TrueToB, sToB)
sq_res <- jaccard_tree_dist(TrueToB, sqToB)
m_res  <- RF.DIFM.jaccard(TrueToB, sToB, sboot_sampled_tob)
srf  <- s_res[1];  srf_sym  <- s_res[3]  + s_res[4]
sqrf <- sq_res[1]; sqrf_sym <- sq_res[3] + sq_res[4]
mrf  <- m_res[1];  mrf_sym  <- m_res[3]  + m_res[4]
numbran   <- length(degree3_split_names(TrueToB) )
numbrans  <-  length(degree3_split_names(sToB) )
numbransq <-  length(degree3_split_names(sqToB) )
numbranm  <-  length(edge_supp(sToB, sboot_sampled_tob))
## --- edge-set distances (degree-3 edges only) ---
sed  <- edge_dist(TrueToB, sToB)
sqed <- edge_dist(TrueToB, sqToB)
med  <- m_res[2:4]
srfbs  <- 0; sqrfbs  <- 0; hrfbs  <- 0; mrfbs  <- 0; Trfbs  <- 0
srfbs_sym <- 0; sqrfbs_sym <- 0; mrfbs_sym <- 0; Trfbs_sym <- 0
Trfbs_a <- 0; Trfbs_b <- 0; Trfbs_c <- 0
srfbs_a  <- 0; srfbs_b  <- 0; srfbs_c  <- 0
sqrfbs_a <- 0; sqrfbs_b <- 0; sqrfbs_c <- 0
mrfbs_a  <- 0; mrfbs_b  <- 0; mrfbs_c  <- 0
avgnmbranches <- 0
T_prec_v  <- s_prec_v  <- sq_prec_v  <- m_prec_v  <- rep(NA_real_, 100)
T_rec_v   <- s_rec_v   <- sq_rec_v   <- m_rec_v   <- rep(NA_real_, 100)
T_f1_v    <- s_f1_v    <- sq_f1_v    <- m_f1_v    <- rep(NA_real_, 100)
T_symn_v  <- s_symn_v  <- sq_symn_v  <- m_symn_v  <- rep(NA_real_, 100)
T_symn2_v  <- s_symn2_v  <- sq_symn2_v  <- m_symn2_v  <- rep(NA_real_, 100)
T_jac_v  <- s_jac_v  <- sq_jac_v  <- m_jac_v  <- rep(NA_real_, 100)
numbranboo   <- length(degree3_split_names(sboot_sampled_tob[[i]]) )
s_bs_res  <- jaccard_tree_dist(  sToB,sboot_sampled_tob[[i]])
sq_bs_res <- jaccard_tree_dist(  sqToB,sboot_sampled_tob[[i]])
m_bs_res  <- RF.DIFM.jaccard( sToB,sboot_sampled_tob[[i]], sboot_sampled_tob)
T_bs_res  <- jaccard_tree_dist(  TrueToB,sboot_sampled_tob[[i]])
srfbs  <- s_bs_res[1]  / 100 + srfbs
sqrfbs <- sq_bs_res[1] / 100 + sqrfbs
mrfbs  <- m_bs_res[1]  / 100 + mrfbs
Trfbs  <- T_bs_res[1]  / 100 + Trfbs
srfbs_sym  <- (s_bs_res[3]  + s_bs_res[4])  / 100 + srfbs_sym
sqrfbs_sym <- (sq_bs_res[3] + sq_bs_res[4]) / 100 + sqrfbs_sym
mrfbs_sym  <- (m_bs_res[3]  + m_bs_res[4])  / 100 + mrfbs_sym
Trfbs_sym  <- (T_bs_res[3]  + T_bs_res[4])  / 100 + Trfbs_sym
avgnmbranches <- (dim(sboot_sampled_tob[[i]]$edge)[1]-21)/100    + avgnmbranches
Trfbs_a <- T_bs_res[2] / 100 + Trfbs_a
Trfbs_b <- T_bs_res[3] / 100 + Trfbs_b
Trfbs_c <- T_bs_res[4] / 100 + Trfbs_c
srfbs_a <- s_bs_res[2] / 100 + srfbs_a
srfbs_b <- s_bs_res[3] / 100 + srfbs_b
srfbs_c <- s_bs_res[4] / 100 + srfbs_c
sqrfbs_a <- sq_bs_res[2] / 100 + sqrfbs_a
sqrfbs_b <- sq_bs_res[3] / 100 + sqrfbs_b
sqrfbs_c <- sq_bs_res[4] / 100 + sqrfbs_c
mrfbs_a <- m_bs_res[2] / 100 + mrfbs_a
mrfbs_b <- m_bs_res[3] / 100 + mrfbs_b
mrfbs_c <- m_bs_res[4] / 100 + mrfbs_c
T_prec_v[i]  <- safe_ratio(T_bs_res[2],  T_bs_res[2]  + T_bs_res[4])
T_rec_v[i]   <- safe_ratio(T_bs_res[2],  T_bs_res[2]  + T_bs_res[3])
T_f1_v[i]    <- f1_ratio(T_prec_v[i], T_rec_v[i])
T_symn_v[i]  <- safe_ratio(T_bs_res[3] + T_bs_res[4], 2 * numbran)
T_symn2_v[i]  <- safe_ratio(T_bs_res[3] + T_bs_res[4], 2 * numbranboo)
T_jac_v[i]  <- jaccard_tree_dist(TrueToB,sboot_sampled_tob[[i]])[1]
s_prec_v[i]  <- safe_ratio(s_bs_res[2],  s_bs_res[2]  + s_bs_res[4])
s_rec_v[i]   <- safe_ratio(s_bs_res[2],  s_bs_res[2]  + s_bs_res[3])
s_f1_v[i]    <- f1_ratio(s_prec_v[i], s_rec_v[i])
s_symn_v[i]  <- safe_ratio(s_bs_res[3] + s_bs_res[4], 2 * numbran)
s_symn2_v[i]  <- safe_ratio(s_bs_res[3] + s_bs_res[4], 2 * numbranboo)
s_jac_v[i]  <- jaccard_tree_dist(sToB,sboot_sampled_tob[[i]])[1]
sq_prec_v[i] <- safe_ratio(sq_bs_res[2], sq_bs_res[2] + sq_bs_res[4])
sq_rec_v[i]  <- safe_ratio(sq_bs_res[2], sq_bs_res[2] + sq_bs_res[3])
sq_f1_v[i]   <- f1_ratio(sq_prec_v[i], sq_rec_v[i])
sq_symn_v[i] <- safe_ratio(sq_bs_res[3] + sq_bs_res[4], 2 * numbran)
sq_symn2_v[i] <- safe_ratio(sq_bs_res[3] + sq_bs_res[4], 2 * numbranboo)
sq_jac_v[i]  <- jaccard_tree_dist(sqToB,sboot_sampled_tob[[i]])[1]
m_prec_v[i]  <- safe_ratio(m_bs_res[2],  m_bs_res[2]  + m_bs_res[4])
m_rec_v[i]   <- safe_ratio(m_bs_res[2],  m_bs_res[2]  + m_bs_res[3])
m_f1_v[i]    <- f1_ratio(m_prec_v[i], m_rec_v[i])
m_symn_v[i]  <- safe_ratio(m_bs_res[3] + m_bs_res[4], 2 * numbran)
m_symn2_v[i]  <- safe_ratio(m_bs_res[3] + m_bs_res[4], 2 * numbranboo)
m_jac_v[i]  <- RF.DIFM.jaccard(sToB,sboot_sampled_tob[[i]],  sboot_sampled_tob)[1]
Trfbs_prec  <- mean(T_prec_v,  na.rm = TRUE); Trfbs_rec  <- mean(T_rec_v,  na.rm = TRUE)
Trfbs_f1    <- mean(T_f1_v,    na.rm = TRUE); Trfbs_symn <- mean(T_symn_v, na.rm = TRUE);
Trfbs_symn2 <- mean(T_symn2_v, na.rm = TRUE)
Trfbs_jac <- mean(T_jac_v, na.rm = TRUE)
srfbs_prec  <- mean(s_prec_v,  na.rm = TRUE); srfbs_rec  <- mean(s_rec_v,  na.rm = TRUE)
srfbs_f1    <- mean(s_f1_v,    na.rm = TRUE); srfbs_symn <- mean(s_symn_v, na.rm = TRUE)
srfbs_symn2 <- mean(s_symn2_v, na.rm = TRUE)
srfbs_jac <- mean(s_jac_v, na.rm = TRUE)
sqrfbs_prec <- mean(sq_prec_v, na.rm = TRUE); sqrfbs_rec <- mean(sq_rec_v, na.rm = TRUE)
sqrfbs_f1   <- mean(sq_f1_v,   na.rm = TRUE); sqrfbs_symn<- mean(sq_symn_v,na.rm = TRUE)
sqrfbs_symn2<- mean(sq_symn2_v,na.rm = TRUE)
sqrfbs_jac<- mean(sq_jac_v,na.rm = TRUE)
mrfbs_prec  <- mean(m_prec_v,  na.rm = TRUE); mrfbs_rec  <- mean(m_rec_v,  na.rm = TRUE)
mrfbs_f1    <- mean(m_f1_v,    na.rm = TRUE); mrfbs_symn <- mean(m_symn_v, na.rm = TRUE)
mrfbs_symn2 <- mean(m_symn2_v, na.rm = TRUE)
mrfbs_jac <- mean(m_jac_v, na.rm = TRUE)
c(numbran, numbrans, numbransq, numbranm,
srf, sqrf, mrf,
sed, sqed, med,
Trfbs, srfbs, sqrfbs, mrfbs, avgnmbranches,
Trfbs_a, Trfbs_b, Trfbs_c,
srfbs_a, srfbs_b, srfbs_c,
sqrfbs_a, sqrfbs_b, sqrfbs_c,
mrfbs_a, mrfbs_b, mrfbs_c,
Trfbs_prec, Trfbs_rec, Trfbs_f1, Trfbs_symn,Trfbs_jac, Trfbs_symn2,
srfbs_prec, srfbs_rec, srfbs_f1, srfbs_symn,srfbs_jac, srfbs_symn2,
sqrfbs_prec, sqrfbs_rec, sqrfbs_f1, sqrfbs_symn,sqrfbs_jac, sqrfbs_symn2,
mrfbs_prec, mrfbs_rec, mrfbs_f1, mrfbs_symn,mrfbs_jac,mrfbs_symn2
)
MM[xx, ] <- c(numbran, numbrans, numbransq, numbranm,
srf, sqrf, mrf,
sed, sqed, med,
Trfbs, srfbs, sqrfbs, mrfbs, avgnmbranches,
Trfbs_a, Trfbs_b, Trfbs_c,
srfbs_a, srfbs_b, srfbs_c,
sqrfbs_a, sqrfbs_b, sqrfbs_c,
mrfbs_a, mrfbs_b, mrfbs_c,
Trfbs_prec, Trfbs_rec, Trfbs_f1, Trfbs_symn,Trfbs_jac, Trfbs_symn2,
srfbs_prec, srfbs_rec, srfbs_f1, srfbs_symn,srfbs_jac, srfbs_symn2,
sqrfbs_prec, sqrfbs_rec, sqrfbs_f1, sqrfbs_symn,sqrfbs_jac, sqrfbs_symn2,
mrfbs_prec, mrfbs_rec, mrfbs_f1, mrfbs_symn,mrfbs_jac,mrfbs_symn2
)
